{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schema/type-definition.json",
  "title": "TypeDefinition",
  "description": "Abstract definition of a canonical data type (type template)",
  "type": "object",
  "required": [
    "name",
    "class",
    "parameters"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Canonical type name",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },

    "class": {
      "type": "string",
      "description": "High-level type class",
      "enum": [
        "numeric",
        "string",
        "date",
        "compound",
        "container"
      ]
    },

    "parameters": {
      "type": "array",
      "description": "Abstract parameter definitions (type signature)",
      "items": {
        "$ref": "#/definitions/parameterDefinition"
      }
    },

    "maxTextLength": {
      "type": ["integer", "null"],
      "description": "Maximum length of textual representation, if applicable",
      "minimum": 1
    },

    "sizeBytes": {
      "type": ["integer", "null"],
      "description": "Typical binary size in bytes, if applicable",
      "minimum": 1
    },

    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false,

  "definitions": {
    "parameterDefinition": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },

        "type": {
          "type": "string",
          "description": "Parameter value type",
          "enum": [
            "integer",
            "number",
            "string",
            "boolean",
            "array",
            "object"
          ]
        },

        "required": {
          "type": "boolean"
        },

        "itemType": {
          "type": "string",
          "description": "Item type for array parameters",
          "enum": [
            "integer",
            "number",
            "string",
            "boolean",
            "object"
          ]
        },

        "min": {
          "type": "number",
          "description": "Minimum allowed value (for numeric parameters)"
        },

        "max": {
          "type": "number",
          "description": "Maximum allowed value (for numeric parameters)"
        },

        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,

      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "array" } }
          },
          "then": {
            "required": ["itemType"]
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["integer", "number"] } }
          },
          "then": {
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        }
      ]
    }
  }
}
