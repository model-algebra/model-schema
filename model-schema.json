{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "http://example.com/model.schema.json",
	"title": "Model",
	"type": "object",
	"properties": {
		"metadata": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"version": {
					"type": "string",
					"pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
				},
				"schema": {
					"type": "string",
					"description": "Database schema (namespace) the model belongs to"
				},
				"description": {
					"type": "string"
				}
			},
			"required": [
				"name",
				"version"
			]
		},
		"fields": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"type": {
						"type": "string",
						"enum": [
							"string",
							"integer",
							"boolean",
							"number",
							"array",
							"object",
							"INT16",
							"INT32",
							"INT64",
							"FLOAT32",
							"FLOAT64",
							"DECIMAL",
							"BOOLEAN",
							"STRING",
							"TEXT",
							"UUID",
							"BYTES",
							"DATE",
							"TIME",
							"DATETIME",
							"TIMESTAMP",
							"TIMESTAMP_TZ",
							"DURATION",
							"OBJECT",
							"ENUM",
							"UNION",
							"JSON",
							"ARRAY"
						]
					},
					"description": {
						"type": "string"
					},
					"parameters": {
						"type": "object"
					},
					"constraints": {
						"type": "object",
						"properties": {
							"primaryKey": {
								"type": "boolean"
							},
							"nullable": {
								"type": "boolean"
							},
							"required": {
								"type": "boolean"
							},
							"unique": {
								"type": "boolean"
							},
							"min": {
								"type": "number"
							},
							"max": {
								"type": "number"
							},
							"enum": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"regex": {
								"type": "string"
							},
							"identity": {
								"type": "string",
								"enum": [
									"always",
									"byDefault"
								],
								"description": "Value generated by the database; integer types only"
							},
							"default": {
								"description": "Default value: either a literal or a database-neutral function",
								"oneOf": [
									{
										"type": "object",
										"properties": {
											"value": {}
										},
										"required": [
											"value"
										],
										"additionalProperties": false
									},
									{
										"type": "object",
										"properties": {
											"function": {
												"type": "string",
												"enum": [
													"now",
													"currentDate",
													"uuid"
												]
											}
										},
										"required": [
											"function"
										],
										"additionalProperties": false
									}
								]
							},
							"foreignKey": {
								"$ref": "#/definitions/foreignKey"
							},
							"foreign_key": {
								"$ref": "#/definitions/foreignKey",
								"description": "Deprecated alias of foreignKey"
							}
						}
					},
					"targets": {
						"$ref": "#/definitions/targets"
					}
				},
				"required": [
					"name",
					"type"
				]
			}
		},
		"constraints": {
			"type": "array",
			"description": "Constraints spanning one or more fields; named so model operations can match them",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"type": {
						"type": "string",
						"enum": [
							"primaryKey",
							"unique",
							"check"
						]
					},
					"fields": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 1
					},
					"rule": {
						"$ref": "#/definitions/rule"
					}
				},
				"required": [
					"name",
					"type"
				],
				"allOf": [
					{
						"if": {
							"properties": {
								"type": {
									"enum": [
										"primaryKey",
										"unique"
									]
								}
							}
						},
						"then": {
							"required": [
								"fields"
							]
						}
					},
					{
						"if": {
							"properties": {
								"type": {
									"const": "check"
								}
							}
						},
						"then": {
							"required": [
								"rule"
							]
						}
					}
				]
			}
		},
		"indexes": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"fields": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 1
					},
					"unique": {
						"type": "boolean"
					},
					"where": {
						"$ref": "#/definitions/rule",
						"description": "Partial index condition"
					},
					"targets": {
						"$ref": "#/definitions/targets"
					}
				},
				"required": [
					"name",
					"fields"
				]
			}
		}
	},
	"required": [
		"metadata",
		"fields"
	],
	"definitions": {
		"foreignKey": {
			"type": "object",
			"properties": {
				"ref": {
					"type": "string",
					"description": "Name of the referenced model"
				},
				"field": {
					"type": "string"
				},
				"onDelete": {
					"$ref": "#/definitions/referentialAction"
				},
				"onUpdate": {
					"$ref": "#/definitions/referentialAction"
				}
			},
			"required": [
				"ref",
				"field"
			]
		},
		"referentialAction": {
			"type": "string",
			"enum": [
				"cascade",
				"setNull",
				"setDefault",
				"restrict",
				"noAction"
			]
		},
		"rule": {
			"type": "object",
			"description": "Comparison of a field with a literal value or with another field",
			"properties": {
				"field": {
					"type": "string"
				},
				"op": {
					"type": "string",
					"enum": [
						"=",
						"!=",
						"<",
						"<=",
						">",
						">="
					]
				},
				"value": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "number"
						},
						{
							"type": "boolean"
						}
					]
				},
				"otherField": {
					"type": "string"
				}
			},
			"required": [
				"field",
				"op"
			],
			"oneOf": [
				{
					"required": [
						"value"
					]
				},
				{
					"required": [
						"otherField"
					]
				}
			]
		},
		"targets": {
			"type": "object",
			"description": "Options understood by one target only, keyed by target name; other targets ignore them",
			"properties": {
				"postgresql": {
					"type": "object",
					"properties": {
						"type": {
							"type": "string",
							"description": "Column type override, e.g. CITEXT or INET[] (fields)"
						},
						"enumType": {
							"type": "string",
							"description": "Name of a native enum type for an ENUM field (fields)"
						},
						"method": {
							"type": "string",
							"enum": [
								"btree",
								"hash",
								"gist",
								"spgist",
								"gin",
								"brin"
							],
							"description": "Index access method (indexes)"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": {
				"type": "object"
			}
		}
	}
}
