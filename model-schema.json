{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "http://example.com/model.schema.json",
	"title": "Model",
	"type": "object",
	"properties": {
		"metadata": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"version": {
					"type": "string",
					"pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
				},
				"schema": {
					"type": "string",
					"description": "Database schema (namespace) the model belongs to"
				},
				"description": {
					"type": "string"
				}
			},
			"required": [
				"name",
				"version"
			]
		},
		"fields": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"type": {
						"type": "string",
						"enum": [
							"string",
							"integer",
							"boolean",
							"number",
							"array",
							"object",
							"date",
							"INT16",
							"INT32",
							"INT64",
							"FLOAT32",
							"FLOAT64",
							"DECIMAL",
							"BOOLEAN",
							"STRING",
							"TEXT",
							"UUID",
							"BYTES",
							"DATE",
							"TIME",
							"DATETIME",
							"TIMESTAMP",
							"TIMESTAMP_TZ",
							"DURATION",
							"OBJECT",
							"ENUM",
							"UNION",
							"JSON",
							"ARRAY"
						]
					},
					"description": {
						"type": "string"
					},
					"parameters": {
						"type": "object"
					},
					"constraints": {
						"type": "object",
						"properties": {
							"primaryKey": {
								"type": "boolean"
							},
							"nullable": {
								"type": "boolean"
							},
							"required": {
								"type": "boolean"
							},
							"unique": {
								"type": "boolean"
							},
							"min": {
								"type": "number"
							},
							"max": {
								"type": "number"
							},
							"enum": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"regex": {
								"type": "string"
							},
							"identity": {
								"type": "string",
								"enum": [
									"always",
									"byDefault"
								],
								"description": "Value generated by the database; integer types only"
							},
							"default": {
								"description": "Default value: either a literal or a database-neutral function",
								"oneOf": [
									{
										"type": "object",
										"properties": {
											"value": {}
										},
										"required": [
											"value"
										],
										"additionalProperties": false
									},
									{
										"type": "object",
										"properties": {
											"function": {
												"type": "string",
												"enum": [
													"now",
													"currentDate",
													"uuid"
												]
											}
										},
										"required": [
											"function"
										],
										"additionalProperties": false
									}
								]
							},
							"foreignKey": {
								"$ref": "#/definitions/foreignKey"
							},
							"foreign_key": {
								"$ref": "#/definitions/foreignKey",
								"description": "Deprecated alias of foreignKey"
							}
						}
					},
					"targets": {
						"$ref": "#/definitions/targets"
					},
					"sortable": {
						"description": "true for the default; one sort definition; or, for several, a map of named ones",
						"oneOf": [
							{
								"type": "boolean"
							},
							{
								"$ref": "#/definitions/sortDefinition"
							},
							{
								"type": "object",
								"minProperties": 2,
								"propertyNames": {
									"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
								},
								"additionalProperties": {
									"$ref": "#/definitions/sortDefinition"
								}
							}
						]
					},
					"filterable": {
						"description": "true for the default; one filter definition; or, for several, a map of named ones",
						"oneOf": [
							{
								"type": "boolean"
							},
							{
								"$ref": "#/definitions/filterDefinition"
							},
							{
								"type": "object",
								"minProperties": 2,
								"propertyNames": {
									"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
								},
								"additionalProperties": {
									"$ref": "#/definitions/filterDefinition"
								}
							}
						]
					}
				},
				"required": [
					"name",
					"type"
				]
			}
		},
		"constraints": {
			"type": "array",
			"description": "Constraints spanning one or more fields; named so model operations can match them",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"type": {
						"type": "string",
						"enum": [
							"primaryKey",
							"unique",
							"check"
						]
					},
					"fields": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 1
					},
					"rule": {
						"$ref": "#/definitions/rule"
					}
				},
				"required": [
					"name",
					"type"
				],
				"allOf": [
					{
						"if": {
							"properties": {
								"type": {
									"enum": [
										"primaryKey",
										"unique"
									]
								}
							}
						},
						"then": {
							"required": [
								"fields"
							]
						}
					},
					{
						"if": {
							"properties": {
								"type": {
									"const": "check"
								}
							}
						},
						"then": {
							"required": [
								"rule"
							]
						}
					}
				]
			}
		},
		"indexes": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"fields": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"minItems": 1
					},
					"unique": {
						"type": "boolean"
					},
					"where": {
						"$ref": "#/definitions/rule",
						"description": "Partial index condition"
					},
					"targets": {
						"$ref": "#/definitions/targets"
					}
				},
				"required": [
					"name",
					"fields"
				]
			}
		},
		"sortings": {
			"type": "object",
			"description": "Named sort orders",
			"propertyNames": {
				"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
			},
			"additionalProperties": {
				"type": "array",
				"items": {
					"$ref": "#/definitions/sortKey"
				},
				"minItems": 1
			}
		},
		"filters": {
			"type": "object",
			"description": "Named filters",
			"propertyNames": {
				"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
			},
			"additionalProperties": {
				"$ref": "#/definitions/modelFilter"
			}
		}
	},
	"required": [
		"metadata",
		"fields"
	],
	"definitions": {
		"foreignKey": {
			"type": "object",
			"properties": {
				"ref": {
					"type": "string",
					"description": "Name of the referenced model"
				},
				"field": {
					"type": "string"
				},
				"onDelete": {
					"$ref": "#/definitions/referentialAction"
				},
				"onUpdate": {
					"$ref": "#/definitions/referentialAction"
				}
			},
			"required": [
				"ref",
				"field"
			]
		},
		"referentialAction": {
			"type": "string",
			"enum": [
				"cascade",
				"setNull",
				"setDefault",
				"restrict",
				"noAction"
			]
		},
		"rule": {
			"type": "object",
			"description": "Comparison of a field with a literal value or with another field",
			"properties": {
				"field": {
					"type": "string"
				},
				"op": {
					"type": "string",
					"enum": [
						"=",
						"!=",
						"<",
						"<=",
						">",
						">="
					]
				},
				"value": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "number"
						},
						{
							"type": "boolean"
						}
					]
				},
				"otherField": {
					"type": "string"
				}
			},
			"required": [
				"field",
				"op"
			],
			"oneOf": [
				{
					"required": [
						"value"
					]
				},
				{
					"required": [
						"otherField"
					]
				}
			]
		},
		"targets": {
			"type": "object",
			"description": "Options understood by one target only, keyed by target name; other targets ignore them",
			"properties": {
				"postgresql": {
					"type": "object",
					"properties": {
						"type": {
							"type": "string",
							"description": "Column type override, e.g. CITEXT or INET[] (fields)"
						},
						"enumType": {
							"type": "string",
							"description": "Name of a native enum type for an ENUM field (fields)"
						},
						"method": {
							"type": "string",
							"enum": [
								"btree",
								"hash",
								"gist",
								"spgist",
								"gin",
								"brin"
							],
							"description": "Index access method (indexes)"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": {
				"type": "object"
			}
		},
		"functionName": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
			"description": "Name of a function or predicate the application provides"
		},
		"argumentType": {
			"type": "object",
			"description": "Type of the value a client gives a predicate, as fields declare types",
			"properties": {
				"type": {
					"type": "string"
				},
				"parameters": {
					"type": "object"
				}
			},
			"required": [
				"type"
			],
			"additionalProperties": false
		},
		"sortDefinition": {
			"type": "object",
			"description": "How records can be sorted by a field",
			"properties": {
				"function": {
					"$ref": "#/definitions/functionName",
					"description": "Sort by function(value, row) instead of the value"
				},
				"direction": {
					"type": "string",
					"enum": [
						"asc",
						"desc",
						"both"
					],
					"description": "Directions clients may sort in (default: both)"
				},
				"nulls": {
					"type": "string",
					"enum": [
						"first",
						"last"
					],
					"description": "Where records without a value go"
				}
			},
			"additionalProperties": false
		},
		"filterDefinition": {
			"type": "object",
			"description": "How records can be filtered by a field",
			"properties": {
				"op": {
					"$ref": "#/definitions/rule/properties/op",
					"description": "Compare the value with the value the client gives, or with value or otherField when given"
				},
				"ops": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/rule/properties/op"
					},
					"minItems": 1,
					"uniqueItems": true,
					"description": "Operators the client chooses from, comparing the value with the value the client gives"
				},
				"value": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "number"
						},
						{
							"type": "boolean"
						}
					],
					"description": "Fixed value to compare with: the client only switches the filter on"
				},
				"otherField": {
					"type": "string",
					"description": "Field to compare with: the client only switches the filter on"
				},
				"function": {
					"$ref": "#/definitions/functionName",
					"description": "Compare function(value, row) instead of the value"
				},
				"predicate": {
					"$ref": "#/definitions/functionName",
					"description": "Keep records for which predicate(value, row) or predicate(value, row, argument) is true"
				},
				"argument": {
					"description": "The value the client gives the predicate: true for one of the type of the field, or a type; without it the client only switches the filter on",
					"oneOf": [
						{
							"const": true
						},
						{
							"$ref": "#/definitions/argumentType"
						}
					]
				}
			},
			"additionalProperties": false,
			"oneOf": [
				{
					"required": [
						"op"
					],
					"not": {
						"anyOf": [
							{
								"required": [
									"ops"
								]
							},
							{
								"required": [
									"predicate"
								]
							},
							{
								"required": [
									"argument"
								]
							},
							{
								"required": [
									"value",
									"otherField"
								]
							}
						]
					}
				},
				{
					"required": [
						"ops"
					],
					"not": {
						"anyOf": [
							{
								"required": [
									"op"
								]
							},
							{
								"required": [
									"predicate"
								]
							},
							{
								"required": [
									"argument"
								]
							},
							{
								"required": [
									"value"
								]
							},
							{
								"required": [
									"otherField"
								]
							}
						]
					}
				},
				{
					"required": [
						"predicate"
					],
					"not": {
						"anyOf": [
							{
								"required": [
									"op"
								]
							},
							{
								"required": [
									"ops"
								]
							},
							{
								"required": [
									"value"
								]
							},
							{
								"required": [
									"otherField"
								]
							},
							{
								"required": [
									"function"
								]
							}
						]
					}
				}
			]
		},
		"sortKey": {
			"type": "object",
			"description": "One key of a sort order: a field, or a function of the whole record",
			"properties": {
				"field": {
					"type": "string"
				},
				"function": {
					"$ref": "#/definitions/functionName",
					"description": "function(value, row) with a field, function(row) without"
				},
				"direction": {
					"type": "string",
					"enum": [
						"asc",
						"desc"
					],
					"description": "Default: asc"
				},
				"nulls": {
					"type": "string",
					"enum": [
						"first",
						"last"
					]
				}
			},
			"anyOf": [
				{
					"required": [
						"field"
					]
				},
				{
					"required": [
						"function"
					]
				}
			],
			"additionalProperties": false
		},
		"modelFilter": {
			"description": "A filter of the model: a rule, or a predicate of the whole record",
			"oneOf": [
				{
					"$ref": "#/definitions/rule"
				},
				{
					"type": "object",
					"properties": {
						"predicate": {
							"$ref": "#/definitions/functionName",
							"description": "Keep records for which predicate(row) or predicate(row, argument) is true"
						},
						"argument": {
							"$ref": "#/definitions/argumentType"
						}
					},
					"required": [
						"predicate"
					],
					"additionalProperties": false
				}
			]
		}
	}
}
